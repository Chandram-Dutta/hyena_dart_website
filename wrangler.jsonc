{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hyena-dart-website",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "hyenadart.onlychan.xyz",
      "custom_domain": true
    }
  ]
}
