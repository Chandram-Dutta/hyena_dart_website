---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Hyena Dart — dead-code and complexity analysis';
const description = 'Dead-code and complexity analysis for Dart and Flutter.';
---

<BaseLayout {title} {description}>
  <section class="hero">
    <div class="shell">
      <h1>Hyena Dart</h1>
      <p class="hero-lede">
        Dead-code and complexity analysis for Dart and Flutter.
      </p>
      <div class="hero-actions">
        <a href="/docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
        <a href="/docs/">Docs</a>
      </div>
      <div class="quick-command">
        <code>dart pub add dev:hyena_dart</code>
        <button
          class="copy-button"
          type="button"
          data-copy="dart pub add dev:hyena_dart"
          aria-label="Copy install command"
        >Copy</button>
      </div>
      <p class="version-note">
        <a href="/docs/migrating-to-v3/">v3.0.0</a> · Dart SDK 3.11+
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy]');

  for (const button of copyButtons) {
    button.addEventListener('click', async () => {
      const value = button.dataset.copy;
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = 'Copy';
        }, 1600);
      } catch {
        button.textContent = 'Select';
      }
    });
  }
</script>
