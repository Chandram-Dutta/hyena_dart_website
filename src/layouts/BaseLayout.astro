---
import '../styles/global.css';
import logo from '../assets/hyena-logo.webp';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const sourceRepository = 'https://github.com/Chandram-Dutta/hyena_dart';
const packageUrl = 'https://pub.dev/packages/hyena_dart';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081b2c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Hyena Dart home">
          <img
            class="wordmark-logo"
            src={logo.src}
            width={logo.width}
            height={logo.height}
            alt=""
            aria-hidden="true"
          />
          <span>Hyena Dart</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/docs/getting-started/">Get started</a>
          <a href="/docs/">Docs</a>
          <a href={packageUrl}>pub.dev</a>
          <a class="github-link" href={sourceRepository}>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11.1 11.1 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" />
            </svg>
            GitHub
          </a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label="Open navigation">Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="/docs/getting-started/">Get started</a>
            <a href="/docs/">Documentation</a>
            <a href={packageUrl}>pub.dev</a>
            <a href={sourceRepository}>GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="wordmark footer-wordmark" href="/">
            <img
              class="wordmark-logo"
              src={logo.src}
              width={logo.width}
              height={logo.height}
              alt=""
              aria-hidden="true"
            />
            <span>Hyena Dart</span>
          </a>
          <p>Static analysis for Dart and Flutter codebases.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/docs/">Documentation</a>
          <a href={sourceRepository}>Source</a>
          <a href={`${sourceRepository}/issues`}>Issues</a>
          <a href={packageUrl}>Package</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
